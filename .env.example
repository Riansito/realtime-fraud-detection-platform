AWS_ENDPOINT_URL_S3="https://<neon-storage-host>.neon.tech"
S3_ENDPOINT_URL="https://<neon-storage-host>.neon.tech"
AWS_ACCESS_KEY_ID="sua_neon_access_key"
AWS_SECRET_ACCESS_KEY="sua_neon_secret_key"
AWS_REGION="us-east-2"
S3_BUCKET_NAME="lakehouse"
S3_BRONZE_PATH="s3a://lakehouse/bronze/transactions/"
S3_SILVER_PATH="s3a://lakehouse/silver/transactions/"
S3_CHECKPOINT_DIR="s3a://lakehouse/checkpoints/"
NEON_DB_URL="postgresql://usuario:senha@host/banco?sslmode=require&channel_binding=require"

# Kafka Variables
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_TOPIC_TRANSACTIONS="transactions"
KAFKA_TOPIC_FRAUD_ALERTS="fraud_alerts"
